# Template for .env (copy it to .env and fill in). Never commit .env.

# --- YouCam API (India region): one key per person, from https://yce.makeupar.com/ai-api ---
# Photos of trial-/noise-<person> are billed to YOUCAM_API_<PERSON>_KEY when it is set,
# otherwise to YOUCAM_API_KEY. The *_SECRET_KEY values are not used by the app.

# Default key (the lab owner)
YOUCAM_API_KEY=
# YOUCAM_API_SECRET_KEY=

# One block per teammate, e.g.
# YOUCAM_API_SAHNI_KEY=
# YOUCAM_API_SAHNI_SECRET_KEY=

# API server
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0

# --- Claim agent: AI providers, tried in this order; any subset, free tiers are enough ---
# Groq: https://console.groq.com/keys   Gemini: https://aistudio.google.com/apikey
# NVIDIA: https://build.nvidia.com      Anthropic (paid): https://console.anthropic.com
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: LLM_PROVIDERS=groq,gemini,nvidia,anthropic  and  <PROVIDER>_MODEL=<model id>

# --- Access from anywhere (Cloudflare Tunnel, see README) ---
# PUBLIC_URL=https://claimtoglow.kharidwise.com
# Token that unlocks the lab on other devices. Optional: one is generated into .lab_token.
# LAB_TOKEN=

# --- Sign-in and admin page (see README: Sign-in) ---
# Owners: these emails become admins on their first sign-in (comma-separated). Others are added
# on the admin page. Without any provider keys, add yourself with: python -m app.users add ...
# ADMIN_EMAILS=you@example.com
# One block per provider you want; a provider with no keys is not offered.
# Callback URL to register with each: https://<your domain>/api/auth/callback/<google|github|linkedin>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Email sign-in links through Resend; EMAIL_FROM on a domain verified there.
# RESEND_API_KEY=
# EMAIL_FROM=Claim to Glow <signin@example.com>
